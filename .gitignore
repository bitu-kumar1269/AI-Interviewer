# Global ignores
node_modules/
.env
logs/
dist/
build/
.DS_Store
Thumbs.db
*.log

# Frontend
/Frontend/node_modules
/Frontend/.env

# backend
/backend/node_modules
/backend/.env

# devops - never commit real secrets or terraform state
/devops/ansible/vars/secrets.yml
/devops/terraform/.terraform/
/devops/terraform/*.tfstate
/devops/terraform/*.tfstate.backup
/devops/terraform/.terraform.lock.hcl
*.pem

